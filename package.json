{
  "name": "mimeforge",
  "version": "0.1.0",
  "description": "Generate file-type icons as SVG from a file extension: 24 bundled bodies, extension labels, pluggable fonts, bodies and colors.",
  "author": {
    "name": "Levent Kurt",
    "email": "reachdevel@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reachdevel/mimeforge.git"
  },
  "homepage": "https://github.com/reachdevel/mimeforge#readme",
  "bugs": {
    "url": "https://github.com/reachdevel/mimeforge/issues"
  },
  "keywords": [
    "file-icons",
    "file-type-icons",
    "svg",
    "icons",
    "mime",
    "extension",
    "generator"
  ],
  "type": "module",
  "bin": {
    "mimeforge": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "third_party",
    "docs",
    "THIRD_PARTY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test-run": "tsx src/cli.ts --test-run",
    "preview": "node scripts/make-preview.mjs",
    "extract-font": "node scripts/extract-font.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "mime-db": "^1.54.0",
    "opentype.js": "^2.0.0"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/mime-db": "^1.43.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
